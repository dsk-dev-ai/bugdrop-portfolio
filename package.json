{
  "name": "bugdrop-portfolio",
  "version": "1.5.0",
  "private": true,
  "description": "BUG DROP — a portfolio where a vending machine dispenses superpowers earned from real bugs. Hosted on AWS Amplify.",
  "license": "MIT",
  "scripts": {
    "serve": "http-server -p 8080 -c-1 .",
    "lint:html": "html-validate index.html 404.html",
    "lint:js": "eslint assets/js",
    "lint:css": "stylelint \"assets/css/**/*.css\"",
    "lint": "npm run lint:html && npm run lint:js && npm run lint:css",
    "test": "node --test tests/*.test.mjs",
    "links": "linkinator http://127.0.0.1:8080 --recurse --skip \"mailto:*\" --skip \"https://github.com/*\"",
    "lighthouse": "lhci autorun"
  },
  "devDependencies": {
    "@lhci/cli": "^0.14.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "html-validate": "^9.7.0",
    "http-server": "^14.1.1",
    "linkinator": "^6.1.2",
    "stylelint": "^16.10.0",
    "stylelint-config-standard": "^36.0.1"
  }
}
